    gridline-color: #1f1f2e;
    font-size: 13px;
    border-radius: 10px;
}

QTableWidget::item
{
    padding: 8px;
}

QHeaderView::section
{
    background-color: #28A745;
    color: white;
    padding: 8px;
    border: none;
    font-size: 14px;
    font-weight: bold;
}

QTableCornerButton::section
{
    background-color: #3A3AF5;
    border: none;
}

QScrollBar:vertical
{
    background: #1a1a28;
    width: 10px;
}

QScrollBar::handle:vertical
{
    background: #3A3AF5;
    border-radius: 5px;
}</string>
        </property>
       </widget>
